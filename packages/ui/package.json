{
  "name": "@bigmobility/vinyl-ui",
  "version": "1.0.0",
  "description": "Bigmobility own Design System. Beautifully designed components built with Ark UI and Panda CSS that work with React frameworks.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "npm run dev",
    "prebuild": "node scripts/sync-exports.mjs",
    "build": "panda codegen && tsup",
    "dev": "tsup --watch",
    "check": "tsc --noEmit",
    "css": "panda codegen",
    "lint": "eslint . --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "watch": "NODE_OPTIONS=--experimental-vm-modules jest --watchAll"
  },
  "author": {
    "name": "bigmobility",
    "url": "https://bigmobility.co.kr"
  },
  "exports": {
    "./accordion": {
      "types": "./dist/accordion.d.ts",
      "import": "./dist/accordion.js",
      "default": "./dist/accordion.js"
    },
    "./badge": {
      "types": "./dist/badge.d.ts",
      "import": "./dist/badge.js",
      "default": "./dist/badge.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js",
      "default": "./dist/button.js"
    },
    "./caption": {
      "types": "./dist/caption.d.ts",
      "import": "./dist/caption.js",
      "default": "./dist/caption.js"
    },
    "./empty-state": {
      "types": "./dist/empty-state.d.ts",
      "import": "./dist/empty-state.js",
      "default": "./dist/empty-state.js"
    },
    "./field": {
      "types": "./dist/field.d.ts",
      "import": "./dist/field.js",
      "default": "./dist/field.js"
    },
    "./help-text": {
      "types": "./dist/help-text.d.ts",
      "import": "./dist/help-text.js",
      "default": "./dist/help-text.js"
    },
    "./icon": {
      "types": "./dist/icon.d.ts",
      "import": "./dist/icon.js",
      "default": "./dist/icon.js"
    },
    "./link": {
      "types": "./dist/link.d.ts",
      "import": "./dist/link.js",
      "default": "./dist/link.js"
    },
    "./result-state": {
      "types": "./dist/result-state.d.ts",
      "import": "./dist/result-state.js",
      "default": "./dist/result-state.js"
    },
    "./select": {
      "types": "./dist/select.d.ts",
      "import": "./dist/select.js",
      "default": "./dist/select.js"
    },
    "./selector-button": {
      "types": "./dist/selector-button.d.ts",
      "import": "./dist/selector-button.js",
      "default": "./dist/selector-button.js"
    },
    "./switch": {
      "types": "./dist/switch.d.ts",
      "import": "./dist/switch.js",
      "default": "./dist/switch.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "import": "./dist/table.js",
      "default": "./dist/table.js"
    },
    "./toast": {
      "types": "./dist/toast.d.ts",
      "import": "./dist/toast.js",
      "default": "./dist/toast.js"
    },
    "./preset": {
      "types": "./dist/preset/index.d.ts",
      "import": "./dist/preset/index.js",
      "default": "./dist/preset/index.js"
    }
  },
  "peerDependencies": {
    "@ark-ui/react": "^5",
    "react": "^19",
    "react-dom": "^19"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "@ark-ui/react": "^5.37.2",
    "@jest/globals": "^30.4.1",
    "@pandacss/dev": "^1.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ts-jest": "^29.4.11",
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "lucide-react": "^1.24.0"
  }
}
